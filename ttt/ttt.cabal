cabal-version: 3.0
name: ttt
version: 0.1.0.0

common shared -- {{{
  mixins:
    , base hiding (Prelude)
    , base-prelude (BasePrelude as Prelude)
  build-depends: base, base-prelude
  ghc-options: -O2
  default-language: GHC2024
  default-extensions:
    , BlockArguments
    , CPP
    , DerivingVia
    , MultiWayIf
    , RecordWildCards
    , ViewPatterns
  build-depends:
    , array
    , random
    , split
    -- , MonadRandom
    -- , atomic-css
    -- , bytestring
    -- , cassava
    -- , containers
    -- , formatting
    -- , hyperbole
    -- , lens
    -- , mtl
    -- , random-shuffle
    -- , text
    -- , vector
-- }}}

library ttt-impl
  import: shared
  hs-source-dirs: ttt-impl
  exposed-modules: TTTImpl

library ttt-game
  import: shared
  hs-source-dirs: ttt-game
  exposed-modules: TTTGame
  build-depends: core, ttt-impl

executable ttt
  import: shared
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: core, ttt-game
