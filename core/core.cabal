cabal-version: 3.0
name: core
version: 0.1.0.0

common shared -- {{{
  mixins:
    , base hiding (Prelude)
    , base-prelude (BasePrelude as Prelude)
  build-depends: base, base-prelude
  ghc-options: -O2
  default-language: GHC2024
  default-extensions:
    , BlockArguments
    , CPP
    , DerivingVia
    , MultiWayIf
    , RecordWildCards
    , ViewPatterns
  build-depends:
    , array
    , random
    , split
    -- , MonadRandom
    -- , atomic-css
    -- , bytestring
    -- , cassava
    -- , containers
    -- , formatting
    -- , hyperbole
    -- , lens
    -- , mtl
    -- , random-shuffle
    -- , text
    -- , vector
-- }}}

library
  import: shared
  exposed-modules: Core.Game, Core.Robot
