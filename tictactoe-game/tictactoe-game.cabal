cabal-version: 3.0
name: tictactoe-game
version: 0.1.0.0

common shared -- {{{
  mixins:
    , base hiding (Prelude)
    , base-prelude (BasePrelude as Prelude)
  build-depends: base, base-prelude
  ghc-options: -O2
  default-language: GHC2024
  default-extensions:
    , BlockArguments
    , CPP
    , DerivingVia
    , MultiWayIf
    , RecordWildCards
    , ViewPatterns
-- }}}

library
  import: shared
  hs-source-dirs: src
  exposed-modules: Game.TicTacToe.Instance
  build-depends:
    , game-class
    , tictactoe
